# Demo default: point at the live Pilgrim Protect API.
# Override this with a LAN IP only when intentionally testing against a local backend.
EXPO_PUBLIC_API_URL=https://pilgrimprotectstory.org/api/v1

# Set this to true only when intentionally running the app against bundled mock data.
# When false/omitted, backend connection failures surface as real errors.
EXPO_PUBLIC_ALLOW_MOCK=false
