{
  "expo": {
    "name": "Pilgrim Protect",
    "slug": "pilgrim-protect-field",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#fbf8f2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.pilgrimprotect.fieldworker",
      "infoPlist": {
        "NSCameraUsageDescription": "We need camera access to photograph sprayed classrooms.",
        "NSPhotoLibraryUsageDescription": "We need photo library access to attach spray report photos.",
        "NSLocationWhenInUseUsageDescription": "We capture your GPS location to verify spray report locations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#eb5a12"
      },
      "package": "org.pilgrimprotect.fieldworker",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-location",
      "expo-image-picker",
      "expo-secure-store",
      "expo-asset",
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": { "light": "#eb5a12", "dark": "#eb5a12" },
              "textColorPrimary": { "light": "#2d2d2d", "dark": "#f5f5f5" }
            }
          }
        }
      ]
    ]
  }
}
